# Client-visible environment. Every EXPO_PUBLIC_* value is embedded in the app bundle.
EXPO_PUBLIC_ENV=development

# Optional backend/auth client configuration (public URL and publishable/legacy anon key only).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional subscriptions.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=pro

# Optional analytics.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_SESSION_REPLAY=false

# Do not put Supabase secret/service_role keys, provider secrets, signing keys, or private API keys here.
